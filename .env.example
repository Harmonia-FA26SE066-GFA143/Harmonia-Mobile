# Harmonia Mobile - Cấu hình biến môi trường (Mẫu)
# Sao chép file này thành `.env` ở root dự án và điền thông tin phù hợp:
# cp .env.example .env

# URL backend API (Mặc định: Harmonia Azure Backend)
# Đối với môi trường phát triển Android Emulator kết nối backend local: http://10.0.2.2:5259
# Đối với thiết bị thật kết nối backend cùng mạng LAN: http://<IP_LAN_CỦA_MÁY_DEV>:5259
API_BASE_URL=https://harmonia-be-a7hneqh4aacsd2e6.southeastasia-01.azurewebsites.net

# API Key (Tuỳ chọn: dùng khi có dịch vụ bên ngoài hoặc endpoint backend yêu cầu API Key)
API_KEY=

# URL SignalR Notification Hub (Tuỳ chọn)
# Để trống để tự động lấy từ origin của API_BASE_URL + /hubs/notifications
NOTIFICATION_HUB_URL=

# Web OAuth Client ID dùng để backend xác minh ID token khi đăng nhập Google
# Được cấu hình trong backend Azure/appsettings (Google__ClientIds)
GOOGLE_CLIENT_ID=
